  "requirements": [
    {
      "id": "identity",
      "classification": "Journal-specific",
      "requirement": "Biomedical Engineering / Biomedizinische Technik; journal key BMTE; De Gruyter Brill; English-language journal.",
      "source": "instructions",
      "pdf_page": 2
    },
    {
      "id": "article_type",
      "classification": "Journal-specific",
      "requirement": "Research Article is suitable for original empirical biosignal/neuroengineering research; other categories are Review Article and Short Communication.",
      "source": "instructions",
      "pdf_page": 2
    },
    {
      "id": "research_length",
      "classification": "Journal-specific",
      "requirement": "Research Article table lists6000words,200-word structured abstract,3-6keywords,8tablesandfigures combined,35references. The table does not specify inclusions/exclusions for the6000words.",
      "source": "instructions",
      "pdf_page": 8
    },
    {
      "id": "abstract",
      "classification": "Mandatory",
      "requirement": "At most200words; Objectives;Methods;Results;Conclusions. Define abbreviations at first use; avoid references; no footnotes,tables,figures,equations.",
      "source": "instructions",
      "pdf_page": 8
    },
    {
      "id": "keywords",
      "classification": "Mandatory",
      "requirement": "3-6specifickeywords; alphabetical order; lower case; separated by semicolons; avoid abbreviations and title-word repetition where possible.",
      "source": "instructions",
      "pdf_page": 8
    },
    {
      "id": "structure",
      "classification": "Journal-specific",
      "requirement": "Title page,structuredAbstract,Keywords,optionalabbreviationlist,Introduction,MaterialsandMethods,Results,Discussion,Acknowledgments,References,tableandfigurelegends. Conclusions are shown in the official Research Article template.",
      "source": "instructions",
      "pdf_page": 8
    },
    {
      "id": "headings",
      "classification": "Mandatory",
      "requirement": "Unnumbered,sentencecase,nofinalperiod; up to4hierarchicallevels; if a level is subdivided it has at least2subheadings.",
      "source": "instructions",
      "pdf_page": 9
    },
    {
      "id": "running_head",
      "classification": "Mandatory",
      "requirement": "Concise running head of at most75characters including spaces; title/subtitle in sentence case,lowercaseaftercolon.",
      "source": "instructions",
      "pdf_page": 7
    },
    {
      "id": "title_page",
      "classification": "Mandatory",
      "requirement": "First page of main manuscript includes fullgiven/familynames,authororder,correspondingauthorasterisk,affiliations,correspondingemail,ORCIDrecommended. The corresponding address includes street,department,institution,city,postalcode,country. Otherauthors require department,institution,city,postalcode,country.",
      "source": "instructions",
      "pdf_page": 7
    },
    {
      "id": "peer_review",
      "classification": "Journal-specific",
      "requirement": "Single-blind; qualifying manuscripts reviewed anonymously by at least2independentreviewers. Do not anonymize author identity as though double-blind. Separate titlepage is not required by the current instructions,which place it on manuscript firstpage.",
      "source": "instructions",
      "pdf_page": 4
    },
    {
      "id": "reviewer_suggestions",
      "classification": "Submission requirement",
      "requirement": "At least5potentialreviewers: names,institution,country,email; institutions different from every author,and should be differentnationality. Do not fabricate,contact or claim completed selection.",
      "source": "instructions",
      "pdf_page": 4
    },
    {
      "id": "cover_letter",
      "classification": "Mandatory",
      "requirement": "Coverletter addressed toEditor-in-Chief for firstsubmission,brieflystatesnovelty. Exclusivity,all-authorauthority and publicdraft history must be accurate.",
      "source": "instructions",
      "pdf_page": 2
    },
    {
      "id": "format",
      "classification": "Allowed",
      "requirement": "Mainmanuscript may be Word orLaTeX; LaTeXsubmission includes completePDF uploaded asMainDocument. Official templates are available.",
      "source": "instructions",
      "pdf_page": 7
    },
    {
      "id": "line_numbers",
      "classification": "Not specified",
      "requirement": "No explicit line-numbering,double-spacing,margin or main-font-size rule was located in the full11pagePDF. Official ResearchArticle DOCX has no w:lnNumType. Line numbering may be added as a review aid,not labelled a journal requirement.",
      "source": "research_article_template",
      "pdf_page": null
    },
    {
      "id": "references",
      "classification": "Mandatory",
      "requirement": "Vancouver; consecutivenumberinginfirstcitationorder includingfigures/tables; in-textsquarebrackets; reference-listnumberswithoutbrackets; journalnameabbreviations; morethan6authors=first6+etal. Alllistedreferencesmustbecitedandviceversa.",
      "source": "instructions",
      "pdf_page": 11
    },
    {
      "id": "figures",
      "classification": "Mandatory",
      "requirement": "Eachfigureuploadedseparately as.jpg,.eps,.pngor.tiff; minimum300dpi pixel/halftone or600dpi combinationpixel/lineart atintendedsize; uppercasepanelletters; text>=6pt,preferArialorHelvetica; captionsseparatefromfigure; citeallfigures.",
      "source": "instructions",
      "pdf_page": 9
    },
    {
      "id": "figure_charges",
      "classification": "Journal-specific",
      "requirement": "Colorfiguresarefree inbothonlineandprinteditions.",
      "source": "instructions",
      "pdf_page": 9
    },
    {
      "id": "tables",
      "classification": "Mandatory",
      "requirement": "EditableWordorLaTeXtables,notimagesorExcel; consecutivenumbers; descriptivetitles,columnheads,units; alphabeticfootnotes; explainabbreviations andbolding.",
      "source": "instructions",
      "pdf_page": 9
    },
    {
      "id": "equations",
      "classification": "Mandatory",
      "requirement": "EditableWordequationeditor/mathtext,notimages; consecutiveArabicnumbersifcited; SIunits.",
      "source": "instructions",
      "pdf_page": 9
    },
    {
      "id": "main_figtable_scope",
