        "basis_provenance"
      ]
    },
    "sgd100": {
      "canonical": "sgd100",
      "fit": "native R3 nonlinear spatial+head SGD100",
      "artifacts": [
        "spatial_basis",
        "basis_provenance"
      ]
    },
    "r3_protected": {
      "canonical": "r3_protected",
      "fit": "native R3 information_protected (actual declared rank4 radius.15 head_l2.1)",
      "artifacts": [
        "spatial_basis",
        "basis_provenance"
      ]
    },
    "r3_tangent_protected": {
      "canonical": "r3_tangent_protected",
      "fit": "native R3 tangent_protected",
      "artifacts": [
        "spatial_basis",
        "basis_provenance"
      ]
    },
    "r4_xfit_select_stack": {
      "canonical": "r4_xfit_select_stack",
      "fit": "native R4 blocked OOF one-SE selection plus simplex Brier stacking; paid prefix positions retained",
      "artifacts": [
        "spatial_basis",
        "basis_provenance"
      ]
    },
    "r8_fiber_bounded": {
      "canonical": "r8_fiber_bounded",
      "fit": "native R8 fixed fiber bounded beta.1 pooled alpha1 shrinkage.05 aligned",
      "artifacts": [
