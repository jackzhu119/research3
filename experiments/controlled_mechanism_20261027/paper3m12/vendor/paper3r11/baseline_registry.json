        "class_reference_provenance"
      ]
    },
    "r9_raw_anchored": {
      "canonical": "r9_raw_rbf_anchored",
      "fit": "native R9 ordinary Bernoulli RBF GP anchored Laplace, original meta-validation selected configuration",
