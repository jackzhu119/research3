        "r9_reference_raw",
        "r9_config_raw",
        "r9_config_provenance_raw"
      ]
    },
    "r9_ea_anchored": {
      "canonical": "r9_ea_linear_anchored",
      "fit": "native R9 ordinary Bernoulli linear GP after actual native support-EA, meta-validation config",
      "artifacts": [
        "r9_reference_ea",
        "r9_config_ea",
        "r9_config_provenance_ea"
      ]
    }
  },
  "artifact_contract": {
    "spatial_basis": {
      "shape": [
        99,
        4
      ],
      "dtype": "float64",
      "role": "meta_train",
      "must_match": [
        "seed",
        "source_checkpoint_sha256",
        "input_contract_sha256"
      ]
    },
    "class_reference": {
      "shape": [
        10,
        10
      ],
      "role": "meta_train_prefix20_only",
      "must_match": [
        "seed",
        "source_checkpoint_sha256",
        "input_contract_sha256"
      ]
    },
    "r9_reference_raw/ea": {
      "keys": [
        "mean",
        "whitener",
        "lengthscale",
        "provenance",
        "diagnostics"
      ],
      "shape": {
        "mean": [
          "feature_dim"
        ],
        "whitener": [
          "feature_dim",
          "feature_dim"
        ]
      },
      "role": "meta_train_prefix20_only",
      "provenance": {
        "preprocessing": "raw or ea"
      }
    },
    "r9_config_raw/ea": {
      "type": "native GPConfig JSON",
      "kernel": {
        "raw": "rbf",
        "ea": "linear"
      },
      "predictive": "anchored_laplace",
      "selection_role": "meta_validation",
      "do_not_infer_from_target": true
    }
  },
  "fit_never_receives_queries": true,
  "target_query_statistics_used": false,
  "missing_artifact_policy": "explicit error, no random or zero learned-artifact substitute",
  "historical_native_source_manifest": "vendor/SOURCE_BASELINES.json"
}
