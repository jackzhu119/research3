  "paired_score_identifiability": {
    "observation_model": "s_ta = m_t + e_ta; s_tb = m_t + e_tb; E[e_ta|m_t]=E[e_tb|m_t]=0; Cov(e_ta,e_tb|m_t)=0",
    "paired_signal_covariance": "Under that model Cov(s_ta,s_tb)=Cov(m_t)=D; symmetrize finite-sample cross covariance; finite-sample PSD projection is regularization, not a proof that assumptions hold.",
    "paired_difference_noise": "If equal within-block noise covariance R and equal block sizes, Cov(s_ta-s_tb)/2=R. With unequal covariances, only (R_a+R_b)/2 is identified; conditional cross-noise adds bias.",
    "eb_update": "For Gaussian scores s=m+e, m~N(mu,D), e~N(0,R/B), the posterior mean is mu+D(D+R/B)^(-1)(s-mu). This is standard Gaussian conditioning/EB shrinkage, not a new R11 theorem.",
    "failure_cases": [
      "Overlapping or nested prefixes share trials and therefore generally have nonzero cross-noise.",
      "Different class balance or acquisition regimes changes E[s|task] and confounds stable adaptation signal with sampling design.",
      "For arbitrary d-dimensional target scores with only20 trials, empirical covariance has rank<=19 before further class constraints.",
      "A global covariance learned across tasks can give nonzero directions but does not imply those directions are identified by target support.",
      "PSD projection and a fixed source anchor ensure numerical/predictive fallback, not unconditional future-session safety."
    ]
  },
  "novelty_collision_assessment": {
    "covered_pieces": [
      "LMM/random effects and empirical-Bayes task updates",
      "MTGP learned task covariance plus task noise",
      "LW/OAS covariance shrinkage",
      "RDA/shrinkage LDA",
      "CORAL/feature whitening"
    ],
    "not_sufficient_for_novelty": "D(D+R/B)^(-1)score、noise-whitening+LDA、φ^TMφ learned kernel、或将它们添加source anchor，均不能独立支撑新算法主张。",
    "possible_distinct_structure_but_not_verified_novel": "若将目标固定支持协议对应的可部署score充分统计量作为单位，预先在meta_train构造不同支持块长/采集间隔/会话的paired观测，联合学习可加性与跨会话可迁移的信号/观测noise operator，并将其转移到20trial的目标后验适配，可形成一项具体研究设计；核心差异必须是对部署支持机制的观测算子建模，而非普通learned covariance。仍须与近年meta-kernel/EB文献进一步核查。",
    "required_ablation": [
      "Source pooled/shrinkage LDA (fixed common covariance)",
      "Raw meta score covariance (no paired noise separation)",
      "Same trace/eigenspectrum random or identity operator",
      "Within-session pair vs cross-session pair vs task-shuffled pair",
      "Marginal-feature CORAL/EA under identical support-only input",
      "Known-noise Fisher/diagonal/identity geometry",
      "Matched-compute learned kernel/metric meta-baseline"
    ],
    "readiness": "仅为文献碰撞和机制可辨识性审计，不是已经证明新颖、可发表或真实EEG有效。"
  },
