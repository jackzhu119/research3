    {
      "id": "SCI-COVARIANCE",
      "finding": "On balanced support, exact conditional permutation covariance equals centered feature covariance divided by4n and cannot identify label correctness.",
      "resolution": "Code has exactly matched feature control and documents this degeneracy; independent equality and enumeration tests pass."
    },
    {
      "id": "ENG-CONFIRMATION-PHASE",
      "finding": "A legal confirmatory DAG includes meta_validation development and selection tasks before independent target evaluation.",
      "resolution": "Plan validator permits explicit development-phase validation while independent target tasks retain confirmatory phase; valid and invalid actual metadata regressions pass."
    },
    {
      "id": "ENG-SELECTION-STAGE",
      "finding": "Selection formerly rejected legal exploratory/confirmatory plans containing a development DAG.",
      "resolution": "Selection accepts these plans only when explicit development evaluation and selection tasks are declared; target-only negative regression remains and poisoned target rows never reach candidate selection."
    },
    {
      "id": "ENG-ACTIVE-STOP",
      "finding": "Persistent active task formerly observed runtime/STOP only between tasks.",
      "resolution": "Dispatcher now checks it once per second and forwards one checkpoint signal; real CPU subprocess checkpoint/orphan-lock tests pass."
    },
    {
      "id": "REPORT-DEFAULT-PROVENANCE",
      "finding": "Unvalidated default selection must remain visible with target comparison outputs.",
      "resolution": "Report and comparison records propagate selection evidence statuses and NO_VALIDATED_SELECTION; statistical suite passes."
    },
    {
      "id": "MATH-OBJECTIVE-LABEL",
      "finding": "Existing majorizer_value includes ridge and needed to be distinguishable from the unregularized bound.",
      "resolution": "Diagnostics explicitly state includes_ridge and record separate ridge_penalty and unregularized_majorizer_value."
    },
    {
      "id": "DOC-IMPLEMENTED-SCOPE",
      "finding": "Proposal wording implied unimplemented EB and own-query-EA controls and an official Meta-Curvature reproduction.",
      "resolution": "Scope now states these limitations and describes actual matched and independently tuned full-matrix ERM controls."
    },
    {
      "id": "DOC-NUMERICAL-ANCHOR",
      "finding": "Numerical implementation clips raw source margin before adding Ag; this differs from merely clipping reported probabilities.",
      "resolution": "Math and proposal now define this fixed numerical anchor and distinguish it from the smooth adapted loss and final probability floor."
    },
    {
      "id": "ENG-CACHE-RNG-EVICTION",
      "finding": "Persistent native source loading must not change task RNG based on cache hit/miss, and a mutated frozen source must not remain in the process cache.",
      "resolution": "Native source construction is wrapped in fork_rng for CPU and the allocated CUDA device; all cache-hit guard failures evict before raise. Three focused CPU regressions pass; CUDA preservation is reviewed code, not a physical GPU test."
    },
    {
      "id": "DELIVERY-CSV-SCOPE",
      "finding": "The source package must contain inspectable compact evidence CSVs without capturing recursive historical raw outputs.",
      "resolution": "Selector includes CSV only below research/evidence and bounded top-level early/late evidence, each at most4MiB; selector and16 delivery tests pass."
