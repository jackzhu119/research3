      ],
      "og:title": [
        "Dropout Training as Adaptive Regularization"
      ],
      "og:url": [
        "https://arxiv.org/abs/1307.1493v2"
      ],
      "og:image": [
        "/static/browse/0.3.4/images/arxiv-logo-fb.png"
      ],
      "og:image:secure_url": [
