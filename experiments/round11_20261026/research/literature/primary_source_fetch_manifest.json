      ],
      "og:title": [
        "Gradient Agreement as an Optimization Objective for Meta-Learning"
      ],
      "og:url": [
        "https://arxiv.org/abs/1810.08178v1"
      ],
      "og:image": [
        "/static/browse/0.3.4/images/arxiv-logo-fb.png"
      ],
      "og:image:secure_url": [
