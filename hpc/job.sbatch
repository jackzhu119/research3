#!/bin/bash
# Resource requests are explicit argv generated by submit.py, not hidden here.
#SBATCH --nodes=1
#SBATCH --ntasks=1
set +x
set -euo pipefail
umask 077

project=''
python=''
stage=''
wall_seconds=''
while [ "$#" -gt 0 ]; do
    case "$1" in
        --root) project="$2"; shift 2 ;;
        --python) python="$2"; shift 2 ;;
        --stage) stage="$2"; shift 2 ;;
        --wall-seconds) wall_seconds="$2"; shift 2 ;;
        *) echo 'Unknown Paper3 job argument.' >&2; exit 64 ;;
    esac
done
if [ -z "${SLURM_JOB_ID:-}" ]; then
    echo 'Paper3 requires sbatch; no stage may run in an ordinary login shell.' >&2
    exit 64
fi
node="${SLURMD_NODENAME:-$(hostname -s)}"
case "$node" in
    login*|login*.*) echo 'Paper3 refuses execution on a login node.' >&2; exit 64 ;;
esac
case "$stage" in
    test|prepare|pilot|train|backup) ;;
    *) echo 'Paper3 job stage is required.' >&2; exit 64 ;;
esac
if [ -z "$project" ] || [ ! -d "$project" ] || [ -z "$python" ] || [ ! -x "$python" ]; then
    echo 'Existing project and Python interpreter must be deployed before sbatch.' >&2
    exit 64
fi
cd -- "$project"
unset PYTHONHOME PYTHONPATH
export VIRTUAL_ENV="$(dirname -- "$(dirname -- "$python")")"
export PATH="$(dirname -- "$python"):$PATH"
export PYTHONDONTWRITEBYTECODE=1 PYTHONUTF8=1 PYTHONUNBUFFERED=1
# These caps are part of the existing reproducibility profile. CPU allocation
# does not authorize changing them or adding concurrent scientific fits.
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1 VECLIB_MAXIMUM_THREADS=1
export PAPER3_HPC_ROOT="$project" PAPER3_HPC_STAGE="$stage"
unset PAPER3_HPC_RUNTIME_PROFILE
case "$stage" in
    pilot|train) export PAPER3_HPC_RUNTIME_PROFILE=school-cu121-v1 ;;
esac
unset PAPER3_HPC_WALL_TIME_SECONDS
if [ -n "$wall_seconds" ]; then
    case "$wall_seconds" in *[!0-9]*) echo 'Invalid administrative wall time.' >&2; exit 64 ;; esac
    export PAPER3_HPC_WALL_TIME_SECONDS="$wall_seconds"
fi
output="$project/.paper3-hpc/jobs/$SLURM_JOB_ID"
mkdir -p -- "$output"

# Keep slow shared-filesystem reads outside every original subprocess/fit
# deadline. This is a verified read cache of existing files, never an install.
bootstrap_failed() {
    "$python" - "$project" "$output" "$stage" "$SLURM_JOB_ID" "$1" <<'PY'
import json, sys
from pathlib import Path
sys.path.insert(0, sys.argv[1])
from hpc.resources import write_json
value = {'schema_version': 'paper3-hpc-stage-receipt-v1', 'stage': sys.argv[3],
    'job_id': sys.argv[4], 'returncode': 2, 'status': 'STOPPED_OR_BLOCKED_NOT_COMPLETE',
    'result': {'status': 'DEPLOYMENT_CACHE_BLOCKED_BEFORE_SCIENTIFIC_STAGE', 'reason': sys.argv[5]},
    'scientific_completion_claimed': False, 'external_query_accessed': False}
write_json(Path(sys.argv[2]) / ('stage-' + sys.argv[3] + '.json'), value)
print(json.dumps(value), flush=True)
PY
    exit 2
}
if [ "$stage" != backup ]; then
    "$python" -u "$project/hpc/node_cache.py" --output "$output/node_cache.json" \
        --env-output "$output/node_cache.env" || bootstrap_failed node_local_runtime_cache_failed
    . "$output/node_cache.env" || bootstrap_failed node_local_cache_activation_failed
    "$python" -u "$project/hpc/project_bytecode.py" --root "$project" \
        --cache-root "$PAPER3_HPC_NODE_CACHE_ROOT" --output "$output/project_bytecode.json" \
        --env-output "$output/project_bytecode.env" || bootstrap_failed frozen_project_bytecode_cache_failed
    . "$output/project_bytecode.env" || bootstrap_failed frozen_project_bytecode_activation_failed
fi
# exec leaves the metrics supervisor as the batch PID. B:USR1 is caught there
# and forwarded only to its owned run_stage coordinator, never all fit workers.
exec "$python" -u "$project/hpc/resources.py" run \
    --root "$project" --stage "$stage" --output "$output" -- \
    "$python" -u "$project/hpc/run_stage.py" --root "$project" --stage "$stage"
